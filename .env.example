# Dono(s) da loja — e-mails com poder de gerenciar quem mais tem acesso ao admin
# (aba "Administradores"). Separe por vírgula se for mais de um. Tem que ser
# exatamente igual à lista hardcoded em firestore.rules (função isOwner()).
VITE_OWNER_EMAIL=

# Firebase (Auth + Firestore) — produtos, banners, cupons e o login do admin
# dependem disso. Veja o passo a passo em README.md > "Firebase".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — upload de imagens de produtos e banners direto do navegador,
# usando um upload preset "unsigned" (não precisa de API secret aqui).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
